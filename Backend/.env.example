# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU BACKEND (AI Learning Assistant Platform)
# ==============================================================================

ENVIRONMENT=development

# ── Database Credentials ──────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/learning_db
MONGODB_URL=mongodb://localhost:27017/chat_db
REDIS_URL=redis://localhost:6379/0

# ── Security & JWT ────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_output_of_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
APP_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=text
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# ── AI Keys ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
USE_DEEPSEEK=false
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# ── Cloudinary (Optional) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email SMTP (Optional) ─────────────────────────────────────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=AI Learning Assistant
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_TIMEOUT_SECONDS=15
