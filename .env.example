# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHUẨN PRODUCTION (AI Learning Assistant Platform)
# Hướng dẫn: Sao chép file này thành .env và điền các giá trị thực tế.
# ==============================================================================

# ── 1. MÔI TRƯỜNG VẬN HÀNH (ENVIRONMENT) ──────────────────────────────────────
# Cài đặt "production" để bật bảo mật Cookie HTTPS, tắt Docs public nếu cần
ENVIRONMENT=production

# ── 2. MẬT KHẨU CƠ SỞ DỮ LIỆU (DATABASE CREDENTIALS) ─────────────────────────
MYSQL_ROOT_PASSWORD=change_this_super_secret_mysql_password_123
MYSQL_DATABASE=learning_db
MYSQL_USER=edumind
MYSQL_PASSWORD=change_this_application_mysql_password
MONGO_INITDB_ROOT_USERNAME=edumind_mongo
MONGO_INITDB_ROOT_PASSWORD=change_this_mongodb_password
REDIS_PASSWORD=change_this_redis_password

# ── 3. BẢO MẬT & MÃ BĂM JWT TOKEN (SECURITY & JWT) ────────────────────────────
# Tạo ngẫu nhiên bằng lệnh: openssl rand -hex 32
SECRET_KEY=replace_with_output_of_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["https://learn.example.com"]
TRUSTED_HOSTS=["learn.example.com"]
APP_URL=https://learn.example.com
LOG_LEVEL=INFO
LOG_FORMAT=json

# TLS files stay on the deployment host and are mounted read-only into Nginx.
TLS_CERT_PATH=/etc/letsencrypt/live/learn.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/learn.example.com/privkey.pem

# Tune these after load testing. Defaults target a small single-host deployment.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=100
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=0.75
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=1.0
MONGO_MEMORY_LIMIT=1g
MONGO_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=0.5
REDIS_MAXMEMORY=384mb
CELERY_MEMORY_LIMIT=2g
CELERY_CPU_LIMIT=2.0

# ── 4. AI CORE PROVIDERS (GEMINI & DEEPSEEK) ──────────────────────────────────
# Google Gemini API Key (Cần thiết cho RAG & AI Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek AI (Tùy chọn: Set USE_DEEPSEEK=true nếu muốn ưu tiên dùng DeepSeek)
USE_DEEPSEEK=false
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# ── 5. CẤU HÌNH KẾT NỐI DB KHI CHẠY LOCAL (KHÔNG QUA DOCKER) ──────────────────
# Lưu ý: Khi chạy bằng Docker, các biến kết nối này sẽ tự động được 
# docker-compose override để kết nối trực tiếp qua Docker Network nội bộ.
DATABASE_URL=mysql+pymysql://root:change_this_super_secret_mysql_password_123@localhost:3306/learning_db
MONGODB_URL=mongodb://localhost:27017/chat_db
REDIS_URL=redis://localhost:6379/0

# ── 6. CLOUDINARY (TÙY CHỌN - LƯU FILE ĐÁM MÂY) ──────────────────────────────
# Nếu để trống, hệ thống sẽ tự động dùng bộ lưu trữ file nội bộ (/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 7. EMAIL SMTP (TÙY CHỌN - GỬI EMAIL THÔNG BÁO / MẬT KHẨU) ─────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@edumind.com
MAIL_FROM_NAME=AI Learning Assistant
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_TIMEOUT_SECONDS=15
